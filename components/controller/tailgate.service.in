[Unit]
Description=Tailgate Headscale controller
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=tailgate
Group=tailgate
ExecStart=/opt/tailgate/bin/headscale --config=/etc/tailgate/headscale.json serve
LoadCredential=oidc_client_secret:/etc/tailgate/secrets/google-client-secret
StateDirectory=tailgate
StateDirectoryMode=0750
RuntimeDirectory=tailgate
RuntimeDirectoryMode=0750
UMask=0077
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=512M
CPUQuota=100%
TasksMax=128
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
